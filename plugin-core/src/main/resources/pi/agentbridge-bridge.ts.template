// AUTO-GENERATED by AgentBridge — do not edit by hand.
// This Pi extension proxies AgentBridge IDE tools (read_file, edit_text, run_command, …)
// plus configured external MCP servers to the Pi agent subprocess.
//
// Mechanism:
//   1) On extension load, fetch `tools/list` from each MCP server URL.
//   2) Register each tool with `pi.registerTool()` so the LLM can call it as
//      `agentbridge_<tool>` (built-in) or `<prefix>_<tool>` (external).
//      The execute() handler forwards the call to `tools/call` on the correct server.
//   3) JSON-RPC 2.0 over Streamable-HTTP (POST /mcp). Initialize handshake is
//      performed lazily — the plugin's MCP server accepts tools/list without
//      requiring `initialize` because the connection is local-trust.
//
// Generated for project: ${AGENTBRIDGE_PROJECT_NAME}
// MCP endpoint        : ${AGENTBRIDGE_MCP_URL}
// Plugin version      : ${AGENTBRIDGE_PLUGIN_VERSION}
// External MCP JSON   : ${AGENTBRIDGE_EXTERNAL_MCP_JSON}

import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { Type } from "typebox";

const BUILTIN_MCP_URL = process.env.AGENTBRIDGE_MCP_URL ?? "${AGENTBRIDGE_MCP_URL}";
const TOOL_PREFIX = "agentbridge_";
const REQUEST_TIMEOUT_MS = 30_000;

interface McpServerConfig {
  name: string;
  url: string;
  toolPrefix: string;
}

let nextRpcId = 1;

interface McpResponse {
  jsonrpc: "2.0";
  id: number;
  result?: unknown;
  error?: { code: number; message: string; data?: unknown };
}

interface McpToolDef {
  name: string;
  description?: string;
  inputSchema?: {
    type?: string;
    properties?: Record<string, unknown>;
    required?: string[];
  };
}

interface McpToolsListResult {
  tools: McpToolDef[];
}

interface McpToolsCallResult {
  content?: Array<{ type: string; text?: string }>;
  isError?: boolean;
  structuredContent?: unknown;
}

function parseExternalServers(): McpServerConfig[] {
  try {
    const raw = process.env.AGENTBRIDGE_EXTERNAL_MCP_JSON ?? "${AGENTBRIDGE_EXTERNAL_MCP_JSON}";
    if (!raw || raw === "${AGENTBRIDGE_EXTERNAL_MCP_JSON}" || raw === "[]") return [];
    return JSON.parse(raw) as McpServerConfig[];
  } catch {
    return [];
  }
}

async function callMcp<T>(url: string, method: string, params: unknown, signal?: AbortSignal): Promise<T> {
  const controller = new AbortController();
  const onAbort = () => controller.abort();
  if (signal) {
    if (signal.aborted) controller.abort();
    else signal.addEventListener("abort", onAbort, { once: true });
  }
  const timer = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
  const id = nextRpcId++;
  try {
    const res = await fetch(url, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json, text/event-stream",
      },
      body: JSON.stringify({ jsonrpc: "2.0", id, method, params }),
      signal: controller.signal,
    });
    const text = await res.text();
    // Streamable-HTTP can reply as JSON or as a single-event SSE; handle both.
    const body = text.startsWith("data:")
      ? text
          .split("\n")
          .filter((l) => l.startsWith("data:"))
          .map((l) => l.slice(5).trim())
          .join("")
      : text;
    const json = JSON.parse(body) as McpResponse;
    if (json.error) {
      throw new Error(`MCP ${method} failed: ${json.error.code} ${json.error.message}`);
    }
    return json.result as T;
  } finally {
    clearTimeout(timer);
    if (signal) signal.removeEventListener("abort", onAbort);
  }
}

function jsonSchemaToTypeBox(schema: McpToolDef["inputSchema"]): unknown {
  if (!schema || schema.type !== "object" || !schema.properties) {
    return Type.Object({});
  }
  const required = new Set(schema.required ?? []);
  const props: Record<string, unknown> = {};
  for (const [key, raw] of Object.entries(schema.properties)) {
    const def = raw as { type?: string; description?: string; enum?: unknown[] };
    let t: unknown;
    switch (def.type) {
      case "string":
        t = def.enum
          ? Type.Union(def.enum.map((e) => Type.Literal(String(e))), { description: def.description })
          : Type.String({ description: def.description });
        break;
      case "integer":
      case "number":
        t = Type.Number({ description: def.description });
        break;
      case "boolean":
        t = Type.Boolean({ description: def.description });
        break;
      case "array":
        t = Type.Array(Type.Any(), { description: def.description });
        break;
      case "object":
        t = Type.Object({}, { additionalProperties: true, description: def.description });
        break;
      default:
        t = Type.Any({ description: def.description });
    }
    props[key] = required.has(key) ? t : Type.Optional(t as never);
  }
  return Type.Object(props);
}

async function registerTools(
  pi: ExtensionAPI,
  server: McpServerConfig,
  prefix: string,
): Promise<void> {
  let toolsResult: McpToolsListResult;
  try {
    toolsResult = await callMcp<McpToolsListResult>(server.url, "tools/list", {});
  } catch (err) {
    // eslint-disable-next-line no-console
    console.error(
      `[agentbridge-bridge] tools/list failed for ${server.name} (${server.url}): ${(err as Error).message}`,
    );
    return;
  }

  for (const tool of toolsResult.tools ?? []) {
    const piName = prefix + tool.name;
    const parameters = jsonSchemaToTypeBox(tool.inputSchema) as never;

    pi.registerTool({
      name: piName,
      label: prefix.replace(/_/g, "/") + tool.name,
      description: tool.description
        ? `[${server.name}] ${tool.description}`
        : `${server.name} tool: ${tool.name}`,
      parameters,
      async execute(_toolCallId, params, signal) {
        try {
          const result = await callMcp<McpToolsCallResult>(
            server.url,
            "tools/call",
            { name: tool.name, arguments: params ?? {} },
            signal,
          );
          const content = (result.content ?? []).map((c) => ({
            type: c.type === "text" ? "text" : "text",
            text: c.text ?? "",
          }));
          return {
            content:
              content.length > 0 ? content : [{ type: "text" as const, text: "(no content)" }],
            details: { isError: result.isError === true },
          };
        } catch (err) {
          return {
            content: [
              { type: "text" as const, text: `Tool error: ${(err as Error).message}` },
            ],
            details: { isError: true },
          };
        }
      },
    });
  }
}

export default async function (pi: ExtensionAPI): Promise<void> {
  const externalServers = parseExternalServers();

  // Register built-in AgentBridge tools
  await registerTools(pi, {
    name: "agentbridge",
    url: BUILTIN_MCP_URL,
    toolPrefix: TOOL_PREFIX,
  }, TOOL_PREFIX);

  // Register tools from each external MCP server
  for (const server of externalServers) {
    // eslint-disable-next-line no-console
    console.log(`[agentbridge-bridge] connecting to external MCP: ${server.name} at ${server.url}`);
    await registerTools(pi, server, server.toolPrefix);
  }
}
