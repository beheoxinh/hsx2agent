// AUTO-GENERATED by AgentBridge — do not edit by hand.
// Pi extension that registers user-defined custom providers via pi.registerProvider().
// API keys are read from environment variables that AgentBridge exports when launching pi.
//
// See: https://pi.dev/docs/latest/custom-provider

import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

interface ProviderSpec {
  id: string;
  name: string;
  baseUrl: string;
  api: string;
  apiKeyEnv: string;
  authHeader: boolean;
  appendSuffix: boolean;
  models: Array<{
    id: string;
    name: string;
    reasoning: boolean;
    image: boolean;
    contextWindow: number;
    maxTokens: number;
  }>;
}

const PROVIDERS: ProviderSpec[] = ${AGENTBRIDGE_PI_PROVIDERS_JSON};

// Endpoint suffixes Pi appends to baseUrl per `api` type. Used to redirect requests
// back to the bare baseUrl when the provider opts out of suffix appending.
const API_SUFFIXES: Record<string, string> = {
  "openai-completions": "/chat/completions",
  "openai-responses": "/responses",
  "openai-codex-responses": "/responses",
  "azure-openai-responses": "/responses",
  "anthropic-messages": "/messages",
  "mistral-conversations": "/conversations",
};

function installBareBaseUrlRedirect(provider: ProviderSpec): void {
  const suffix = API_SUFFIXES[provider.api];
  if (!suffix) return;
  const expected = provider.baseUrl.replace(/\/+$/, "") + suffix;
  const target = provider.baseUrl.replace(/\/+$/, "");
  const originalFetch = globalThis.fetch.bind(globalThis);
  globalThis.fetch = (input: RequestInfo | URL, init?: RequestInit) => {
    let url = typeof input === "string" ? input : input instanceof URL ? input.toString() : input.url;
    if (url === expected || url.startsWith(expected + "?")) {
      const rewritten = url.replace(expected, target);
      // eslint-disable-next-line no-console
      console.error(`[agentbridge-providers] rewrote ${url} -> ${rewritten}`);
      if (typeof input === "string") return originalFetch(rewritten, init);
      if (input instanceof URL) return originalFetch(new URL(rewritten), init);
      return originalFetch(new Request(rewritten, input), init);
    }
    return originalFetch(input, init);
  };
}

export default function (pi: ExtensionAPI): void {
  // eslint-disable-next-line no-console
  console.error(`[agentbridge-providers] loaded ${PROVIDERS.length} provider(s): ${PROVIDERS.map((p) => p.id).join(", ")}`);
  for (const p of PROVIDERS) {
    try {
      pi.registerProvider(p.id, {
        name: p.name,
        baseUrl: p.baseUrl,
        apiKey: p.apiKeyEnv,
        api: p.api as never,
        authHeader: p.authHeader,
        models: p.models.map((m) => ({
          id: m.id,
          name: m.name,
          reasoning: m.reasoning,
          input: m.image ? ["text", "image"] : ["text"],
          cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
          contextWindow: m.contextWindow,
          maxTokens: m.maxTokens,
        })),
      });
      if (!p.appendSuffix) {
        installBareBaseUrlRedirect(p);
      }
    } catch (err) {
      // eslint-disable-next-line no-console
      console.error(`[agentbridge-providers] failed to register ${p.id}: ${(err as Error).message}`);
    }
  }
}
